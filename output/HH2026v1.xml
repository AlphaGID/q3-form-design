<?xml version="1.0"?><h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:orx="http://openrosa.org/xforms" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Integrated Child Health and AMR Survey 2026</h:title><model odk:xforms-version="1.0.0"><instance><data id="hh2026_v1" version="2026070200"><section1><lga/><ward/><settlement/><settlement_known_locally/><settlement_local_name/><structure_number/><hh_serial_number/><enumerator_code/><team_code_calc/><team_code_display/><visit_date/><gps_reading/><gps_lat/><gps_lon/><settlement_lat_calc/><settlement_lon_calc/><gps_plausibility_flag/><prev_round_visited/><prev_household_id/><result_of_visit/></section1><section2><consent_read_aloud/><consent_given/><respondent_relationship/></section2><section3><household_size/><roster jr:template=""><name_initials/><relationship_to_head/><sex/><under5/><age_years/><age_months/><eligible_for_section4/><section4_module><roster_line_number/><s4_child_ref/><weight_status/><weight_kg/><height_status/><height_cm/><measurement_position/><card_seen/><measles_on_card/><measles_ever/><diarrhoea_14d/><antibiotic_30d/><antibiotic_name/><antibiotic_no_prescription/><antibiotic_photo_taken/></section4_module></roster><roster><name_initials/><relationship_to_head/><sex/><under5/><age_years/><age_months/><eligible_for_section4/><section4_module><roster_line_number/><s4_child_ref/><weight_status/><weight_kg/><height_status/><height_cm/><measurement_position/><card_seen/><measles_on_card/><measles_ever/><diarrhoea_14d/><antibiotic_30d/><antibiotic_name/><antibiotic_no_prescription/><antibiotic_photo_taken/></section4_module></roster><eligible_children_count/><eligible_children_display/></section3><meta><instanceID/></meta></data></instance><instance id="wards" src="jr://file-csv/wards.csv"/><instance id="settlements" src="jr://file-csv/settlements.csv"/><instance id="staff_roster" src="jr://file-csv/staff_roster.csv"/><instance id="previous_round_households" src="jr://file-csv/previous_round_households.csv"/><instance id="lga_list"><root><item><name>LGA02</name><label>Gwarin</label></item><item><name>LGA01</name><label>Idi-Oro</label></item><item><name>LGA04</name><label>Ilela</label></item><item><name>LGA03</name><label>Katsuma</label></item></root></instance><instance id="yesno"><root><item><name>1</name><label>Yes</label></item><item><name>2</name><label>No</label></item></root></instance><instance id="visited_previous_list"><root><item><name>1</name><label>Yes</label></item><item><name>2</name><label>No</label></item><item><name>8</name><label>Do not know</label></item></root></instance><instance id="visit_result_list"><root><item><name>1</name><label>Completed</label></item><item><name>2</name><label>Refused</label></item><item><name>3</name><label>No competent adult after three visits</label></item><item><name>4</name><label>Dwelling vacant or demolished</label></item></root></instance><instance id="consent_list"><root><item><name>1</name><label>Consent given</label></item><item><name>2</name><label>Consent refused</label></item></root></instance><instance id="relationship_list"><root><item><name>1</name><label>Head</label></item><item><name>2</name><label>Spouse</label></item><item><name>3</name><label>Son or daughter</label></item><item><name>4</name><label>Parent</label></item><item><name>5</name><label>Other relative</label></item><item><name>6</name><label>Not related</label></item></root></instance><instance id="sex_list"><root><item><name>1</name><label>Male</label></item><item><name>2</name><label>Female</label></item></root></instance><instance id="yesnodk_list"><root><item><name>1</name><label>Yes</label></item><item><name>2</name><label>No</label></item><item><name>8</name><label>Do not know</label></item></root></instance><instance id="measured_status_list"><root><item><name>1</name><label>Measured</label></item><item><name>2</name><label>Not measured</label></item></root></instance><instance id="card_seen_list"><root><item><name>1</name><label>Card seen</label></item><item><name>2</name><label>No card seen</label></item></root></instance><instance id="position_list"><root><item><name>1</name><label>Recumbent length</label></item><item><name>2</name><label>Standing height</label></item></root></instance><instance id="photo_taken_list"><root><item><name>1</name><label>Yes</label></item><item><name>2</name><label>No, not available</label></item><item><name>3</name><label>Caregiver declined</label></item></root></instance><bind nodeset="/data/section1/lga" type="string" required="true()"/><bind nodeset="/data/section1/ward" type="string" required="true()"/><bind nodeset="/data/section1/settlement" type="string" required="true()"/><bind nodeset="/data/section1/settlement_known_locally" type="string" required="true()"/><bind nodeset="/data/section1/settlement_local_name" type="string" required=" /data/section1/settlement_known_locally ='1'" relevant=" /data/section1/settlement_known_locally ='1'"/><bind nodeset="/data/section1/structure_number" type="int" required="true()" constraint=". &gt;= 1 and . &lt;= 999" jr:constraintMsg="Enter a number between 1 and 999"/><bind nodeset="/data/section1/hh_serial_number" type="int" required="true()" constraint=". &gt;= 1 and . &lt;= 999" jr:constraintMsg="Enter a number between 1 and 999"/><bind nodeset="/data/section1/enumerator_code" type="string" required="true()"/><bind nodeset="/data/section1/team_code_calc" type="string" calculate="pulldata('staff_roster','team_code','name', /data/section1/enumerator_code )"/><bind nodeset="/data/section1/team_code_display" type="string" calculate=" /data/section1/team_code_calc " readonly="true()"/><bind nodeset="/data/section1/visit_date" type="date" required="true()" constraint=". &gt;= date('2026-06-01') and . &lt;= date('2026-06-30')" jr:constraintMsg="Date must be within the fieldwork period, 1-30 June 2026"/><bind nodeset="/data/section1/gps_reading" type="geopoint" required="true()"/><bind nodeset="/data/section1/gps_lat" type="string" calculate="substring-before( /data/section1/gps_reading ,' ')"/><bind nodeset="/data/section1/gps_lon" type="string" calculate="substring-before(substring-after( /data/section1/gps_reading ,' '),' ')"/><bind nodeset="/data/section1/settlement_lat_calc" type="string" calculate="pulldata('settlements','latitude','name', /data/section1/settlement )"/><bind nodeset="/data/section1/settlement_lon_calc" type="string" calculate="pulldata('settlements','longitude','name', /data/section1/settlement )"/><bind nodeset="/data/section1/gps_plausibility_flag" readonly="true()" type="string" relevant="( /data/section1/gps_reading !='') and ((abs(number( /data/section1/gps_lat ) - number( /data/section1/settlement_lat_calc )) &gt; 0.05) or (abs(number( /data/section1/gps_lon ) - number( /data/section1/settlement_lon_calc )) &gt; 0.05))"/><bind nodeset="/data/section1/prev_round_visited" type="string" required="true()"/><bind nodeset="/data/section1/prev_household_id" type="string" relevant=" /data/section1/prev_round_visited ='1'" constraint="pulldata('previous_round_households','household_id','household_id',.) != ''" jr:constraintMsg="This household ID was not found in the previous round register. Please check and re-enter."/><bind nodeset="/data/section1/result_of_visit" type="string" required="true()"/><bind nodeset="/data/section2" relevant=" /data/section1/result_of_visit ='1'"/><bind nodeset="/data/section2/consent_read_aloud" type="string" required="true()"/><bind nodeset="/data/section2/consent_given" type="string" required="true()"/><bind nodeset="/data/section2/respondent_relationship" type="string" required="true()" relevant=" /data/section2/consent_given ='1'"/><bind nodeset="/data/section3" relevant=" /data/section1/result_of_visit ='1' and  /data/section2/consent_given ='1'"/><bind nodeset="/data/section3/household_size" type="int" required="true()" constraint=". &gt;= 1 and . &lt;= 30" jr:constraintMsg="Enter a number between 1 and 30"/><bind nodeset="/data/section3/roster/name_initials" type="string" required="true()"/><bind nodeset="/data/section3/roster/relationship_to_head" type="string" required="true()"/><bind nodeset="/data/section3/roster/sex" type="string" required="true()"/><bind nodeset="/data/section3/roster/under5" type="string" required="true()"/><bind nodeset="/data/section3/roster/age_years" type="int" required=" ../under5 ='2'" relevant=" ../under5 ='2'" constraint=". &gt;= 5 and . &lt;= 120" jr:constraintMsg="Enter age in completed years, 5 or older"/><bind nodeset="/data/section3/roster/age_months" type="int" required=" ../under5 ='1'" relevant=" ../under5 ='1'" constraint=". &gt;= 0 and . &lt;= 59" jr:constraintMsg="Enter age in completed months, 0 to 59"/><bind nodeset="/data/section3/roster/eligible_for_section4" type="string" calculate="if( ../under5 ='1' and  ../age_months  &gt;= 9 and  ../age_months  &lt;= 59, 1, 0)"/><bind nodeset="/data/section3/roster/section4_module" relevant=" ../eligible_for_section4 ='1'"/><bind nodeset="/data/section3/roster/section4_module/roster_line_number" type="string" calculate="position(..)"/><bind nodeset="/data/section3/roster/section4_module/s4_child_ref" readonly="true()" type="string"/><bind nodeset="/data/section3/roster/section4_module/weight_status" type="string" required="true()"/><bind nodeset="/data/section3/roster/section4_module/weight_kg" type="decimal" required=" ../weight_status ='1'" relevant=" ../weight_status ='1'" constraint=". &gt;= 2.0 and . &lt;= 30.0" jr:constraintMsg="Enter weight in kg, 2.0 to 30.0"/><bind nodeset="/data/section3/roster/section4_module/height_status" type="string" required="true()"/><bind nodeset="/data/section3/roster/section4_module/height_cm" type="decimal" required=" ../height_status ='1'" relevant=" ../height_status ='1'" constraint=". &gt;= 60.0 and . &lt;= 120.0" jr:constraintMsg="Enter length/height in cm, 60.0 to 120.0"/><bind nodeset="/data/section3/roster/section4_module/measurement_position" type="string" required=" ../height_status ='1'" relevant=" ../height_status ='1'"/><bind nodeset="/data/section3/roster/section4_module/card_seen" type="string" required="true()"/><bind nodeset="/data/section3/roster/section4_module/measles_on_card" type="string" required=" ../card_seen ='1'" relevant=" ../card_seen ='1'"/><bind nodeset="/data/section3/roster/section4_module/measles_ever" type="string" required=" ../card_seen ='2'" relevant=" ../card_seen ='2'"/><bind nodeset="/data/section3/roster/section4_module/diarrhoea_14d" type="string" required="true()"/><bind nodeset="/data/section3/roster/section4_module/antibiotic_30d" type="string" required="true()"/><bind nodeset="/data/section3/roster/section4_module/antibiotic_name" type="string" required=" ../antibiotic_30d ='1'" relevant=" ../antibiotic_30d ='1'"/><bind nodeset="/data/section3/roster/section4_module/antibiotic_no_prescription" type="string" required=" ../antibiotic_30d ='1'" relevant=" ../antibiotic_30d ='1'"/><bind nodeset="/data/section3/roster/section4_module/antibiotic_photo_taken" type="string" required=" ../antibiotic_30d ='1'" relevant=" ../antibiotic_30d ='1'"/><bind nodeset="/data/section3/eligible_children_count" type="string" calculate="sum(../roster/eligible_for_section4)"/><bind nodeset="/data/section3/eligible_children_display" type="string" calculate=" /data/section3/eligible_children_count " readonly="true()"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/></model></h:head><h:body class="pages"><group ref="/data/section1"><label>Section 1: Household identification</label><select1 ref="/data/section1/lga"><label>1.02 Local Government Area</label><itemset nodeset="instance('lga_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section1/ward"><label>1.03 Ward</label><itemset nodeset="instance('wards')/root/item[lga_code= /data/section1/lga ]"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section1/settlement"><label>1.04 Settlement</label><itemset nodeset="instance('settlements')/root/item[ward_code= /data/section1/ward ]"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section1/settlement_known_locally"><label>1.05 Is the settlement known locally by a different name?</label><itemset nodeset="instance('yesno')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/section1/settlement_local_name"><label>Name used locally</label></input><input ref="/data/section1/structure_number"><label>1.06 Structure number painted on the dwelling</label></input><input ref="/data/section1/hh_serial_number"><label>1.07 Household serial number within the settlement</label></input><select1 ref="/data/section1/enumerator_code"><label>1.08 Enumerator code</label><itemset nodeset="instance('staff_roster')/root/item[role='Enumerator']"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/section1/team_code_display"><label>1.09 Team code</label></input><input ref="/data/section1/visit_date"><label>1.10 Date of visit</label></input><input ref="/data/section1/gps_reading"><label>1.11 Record the GPS reading taken at the entrance to the dwelling.</label></input><input ref="/data/section1/gps_plausibility_flag"><label>This GPS reading looks far from the registered location of the selected settlement. Please confirm this is the correct dwelling before continuing.</label></input><select1 ref="/data/section1/prev_round_visited"><label>1.12 Was this household visited during the October 2025 round?</label><itemset nodeset="instance('visited_previous_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/section1/prev_household_id"><label>1.13 Record the household identifier allocated in the October 2025 round.</label></input><select1 ref="/data/section1/result_of_visit"><label>1.14 Result of visit</label><itemset nodeset="instance('visit_result_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/section2"><label>Section 2: Consent</label><select1 ref="/data/section2/consent_read_aloud"><label>2.01 Consent statement read aloud to the respondent in full?</label><itemset nodeset="instance('yesno')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section2/consent_given"><label>2.02 Does the respondent consent to the household interview?</label><itemset nodeset="instance('consent_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section2/respondent_relationship"><label>2.03 Relationship of the respondent to the head of household</label><itemset nodeset="instance('relationship_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/section3"><label>Section 3: Household roster</label><input ref="/data/section3/household_size"><label>3.01 How many people usually live in this household?</label></input><group ref="/data/section3/roster"><label>Household roster</label><repeat nodeset="/data/section3/roster" jr:count=" /data/section3/household_size "><input ref="/data/section3/roster/name_initials"><label>(2) Name or initials</label></input><select1 ref="/data/section3/roster/relationship_to_head"><label>(3) Relationship to head</label><itemset nodeset="instance('relationship_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/sex"><label>(4) Sex</label><itemset nodeset="instance('sex_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/under5"><label>Is this person under 5 years old?</label><itemset nodeset="instance('yesno')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/section3/roster/age_years"><label>(5) Age in completed years</label></input><input ref="/data/section3/roster/age_months"><label>(6) Age in completed months (under 5 only)</label></input><group ref="/data/section3/roster/section4_module"><label>Section 4: Child module</label><input ref="/data/section3/roster/section4_module/s4_child_ref"><label> This module is for: <output value=" ../../name_initials "/>, <output value=" ../../age_months "/> months, line <output value=" ../roster_line_number "/> </label></input><select1 ref="/data/section3/roster/section4_module/weight_status"><label>4.05 Weight of the child</label><itemset nodeset="instance('measured_status_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/section3/roster/section4_module/weight_kg"><label>Weight (kg)</label></input><select1 ref="/data/section3/roster/section4_module/height_status"><label>4.06 Length or height of the child</label><itemset nodeset="instance('measured_status_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/section3/roster/section4_module/height_cm"><label>Length or height (cm)</label></input><select1 ref="/data/section3/roster/section4_module/measurement_position"><label>4.07 Position in which the child was measured</label><itemset nodeset="instance('position_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/section4_module/card_seen"><label>4.08 May I see the child's vaccination card or health record?</label><itemset nodeset="instance('card_seen_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/section4_module/measles_on_card"><label>4.09 Copy from the card: is a measles dose recorded?</label><itemset nodeset="instance('yesno')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/section4_module/measles_ever"><label>4.10 Has this child ever received a measles vaccination?</label><itemset nodeset="instance('yesnodk_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/section4_module/diarrhoea_14d"><label>4.11 Has this child had diarrhoea in the past 14 days?</label><itemset nodeset="instance('yesnodk_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/section4_module/antibiotic_30d"><label>4.12 Has this child taken any antibiotic medicine in the past 30 days?</label><itemset nodeset="instance('yesnodk_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/section3/roster/section4_module/antibiotic_name"><label>4.13/4.14 Which antibiotic was taken? Record the name as reported by the caregiver.</label><hint>OPEN ITEM: no controlled medicine list was supplied with the data pack (see defects log D01). Recorded as free text pending that list.</hint></input><select1 ref="/data/section3/roster/section4_module/antibiotic_no_prescription"><label>4.15 Was the medicine obtained without a prescription from a health worker?</label><itemset nodeset="instance('yesnodk_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/section4_module/antibiotic_photo_taken"><label>4.16 Was a photograph of the medicine packaging taken?</label><itemset nodeset="instance('photo_taken_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group></repeat></group><input ref="/data/section3/eligible_children_display"><label>3.02 Number of children aged 9 to 59 completed months (calculated automatically from the roster)</label></input></group></h:body></h:html>