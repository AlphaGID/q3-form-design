alue ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/section2"><label>Section 2: Consent</label><select1 ref="/data/section2/consent_read_aloud"><label>2.01 Consent statement read aloud to the respondent in full?</label><itemset nodeset="instance('yesno')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section2/consent_given"><label>2.02 Does the respondent consent to the household interview?</label><itemset nodeset="instance('consent_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section2/respondent_relationship"><label>2.03 Relationship of the respondent to the head of household</label><itemset nodeset="instance('relationship_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/section3"><label>Section 3: Household roster</label><input ref="/data/section3/household_size"><label>3.01 How many people usually live in this household?</label></input><group ref="/data/section3/roster"><label>Household roster</label><repeat nodeset="/data/section3/roster" jr:count=" /data/section3/household_size "><input ref="/data/section3/roster/name_initials"><label>(2) Name or initials</label></input><select1 ref="/data/section3/roster/relationship_to_head"><label>(3) Relationship to head</label><itemset nodeset="instance('relationship_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/sex"><label>(4) Sex</label><itemset nodeset="instance('sex_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/under5"><label>Is this person under 5 years old?</label><itemset nodeset="instance('yesno')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/section3/roster/age_years"><label>(5) Age in completed years</label></input><input ref="/data/section3/roster/age_months"><label>(6) Age in completed months (under 5 only)</label></input><group ref="/data/section3/roster/section4_module"><label>Section 4: Child module</label><input ref="/data/section3/roster/section4_module/s4_child_ref"><label> This module is for: <output value=" ../../name_initials "/>, <output value=" ../../age_months "/> months, line <output value=" ../roster_line_number "/> </label></input><select1 ref="/data/section3/roster/section4_module/weight_status"><label>4.05 Weight of the child</label><itemset nodeset="instance('measured_status_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/section3/roster/section4_module/weight_kg"><label>Weight (kg)</label></input><select1 ref="/data/section3/roster/section4_module/height_status"><label>4.06 Length or height of the child</label><itemset nodeset="instance('measured_status_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/section3/roster/section4_module/height_cm"><label>Length or height (cm)</label></input><select1 ref="/data/section3/roster/section4_module/measurement_position"><label>4.07 Position in which the child was measured</label><itemset nodeset="instance('position_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/section4_module/card_seen"><label>4.08 May I see the child's vaccination card or health record?</label><itemset nodeset="instance('card_seen_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/section4_module/measles_on_card"><label>4.09 Copy from the card: is a measles dose recorded?</label><itemset nodeset="instance('yesno')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/section4_module/measles_ever"><label>4.10 Has this child ever received a measles vaccination?</label><itemset nodeset="instance('yesnodk_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/section4_module/diarrhoea_14d"><label>4.11 Has this child had diarrhoea in the past 14 days?</label><itemset nodeset="instance('yesnodk_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/section4_module/antibiotic_30d"><label>4.12 Has this child taken any antibiotic medicine in the past 30 days?</label><itemset nodeset="instance('yesnodk_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/section3/roster/section4_module/antibiotic_name"><label>4.13/4.14 Which antibiotic was taken? Record the name as reported by the caregiver.</label><hint>OPEN ITEM: no controlled medicine list was supplied with the data pack (see defects log D01). Recorded as free text pending that list.</hint></input><select1 ref="/data/section3/roster/section4_module/antibiotic_no_prescription"><label>4.15 Was the medicine obtained without a prescription from a health worker?</label><itemset nodeset="instance('yesnodk_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/section4_module/antibiotic_photo_taken"><label>4.16 Was a photograph of the medicine packaging taken?</label><itemset nodeset="instance('photo_taken_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1></group><group ref="/data/section3/roster/section5_module"><label>Section 5: Specimen collection</label><select1 ref="/data/section3/roster/section5_module/age12plus"><label>5.01 Is the child aged 12 completed months or older?</label><itemset nodeset="instance('yesno')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section3/roster/section5_module/specimen_obtained"><label>5.02 Was a stool specimen obtained from this child?</label><itemset nodeset="instance('yesno')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/section3/roster/section5_module/specimen_number"><label>5.03 Specimen label number (6 digits printed after the BSN prefix)</label></input><input ref="/data/section3/roster/section5_module/specimen_check_digit"><label>Check digit (single digit 0-9, or X)</label></input><input ref="/data/section3/roster/section5_module/specimen_coldbox_time"><label>5.04 Time the specimen was placed in the cold box</label></input><input ref="/data/section3/roster/section5_module/specimen_coldbox_temp"><label>5.05 Temperature shown on the cold box thermometer at that time</label></input><select1 ref="/data/section3/roster/section5_module/reason_no_specimen"><label>5.06 Reason no specimen was obtained</label><itemset nodeset="instance('reason_no_specimen_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/section3/roster/section5_module/reason_no_specimen_other"><label>5.07 If code 96, specify</label></input></group></repeat></group><input ref="/data/section3/eligible_children_display"><label>3.02 Number of children aged 9 to 59 completed months (calculated automatically from the roster)</label></input></group><group ref="/data/section6"><label>Section 6: Household environment</label><select1 ref="/data/section6/water_source"><label>6.01 What is the main source of drinking water for members of this household?</label><itemset nodeset="instance('water_source_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section6/toilet_type"><label>6.02 What kind of toilet facility do members of this household usually use?</label><itemset nodeset="instance('toilet_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section6/keeps_animals"><label>6.03 Does this household keep poultry or livestock inside the compound?</label><itemset nodeset="instance('yesno')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section6/animal_antibiotics_12m"><label>6.04 Have any antibiotic medicines been given to these animals in the past 12 months?</label><itemset nodeset="instance('yesnodk_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section6/handwashing_station"><label>6.05 Observe: is there a handwashing station with both soap and water available?</label><itemset nodeset="instance('handwashing_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section6/hh_diarrhoea_2w"><label>6.06 Has any member of this household had diarrhoea in the past two weeks?</label><itemset nodeset="instance('yesnodk_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><select ref="/data/section6/household_assets"><label>6.07 Which of the following does this household own?</label><itemset nodeset="instance('assets_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select></group><group ref="/data/section7"><label>Section 7: Close-out and supervisor review</label><input ref="/data/section7/interview_end_time"><label>7.01 Time the interview ended</label></input><input ref="/data/section7/office_observation"><label>7.02 Record any observation that may help the office interpret this form.</label></input><input ref="/data/section7/enumerator_signature"><label>7.03 Enumerator signature</label></input><input ref="/data/section7/enumerator_signature_date"><label>Enumerator signature date</label></input><select1 ref="/data/section7/supervisor_code"><label>7.04 Supervisor code</label><itemset nodeset="instance('staff_roster')/root/item[role='Supervisor']"><value ref="name"/><label ref="label"/></itemset></select1><select1 ref="/data/section7/supervisor_decision"><label>7.05 Supervisor decision on this form</label><itemset nodeset="instance('supervisor_decision_list')/root/item"><value ref="name"/><label ref="label"/></itemset></select1><input ref="/data/section7/supervisor_signature"><label>7.06 Supervisor signature</label></input><input ref="/data/section7/supervisor_signature_date"><label>Supervisor signature date</label></input></group></h:body></h:html>